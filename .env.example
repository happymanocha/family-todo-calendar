# Environment Configuration for Serverless Deployment

# JWT Secret for token signing (REQUIRED)
JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-complex

# AWS Configuration
AWS_REGION=us-east-1
AWS_PROFILE=default

# DynamoDB Table Names (automatically set by serverless.yml)
TODOS_TABLE=minocha-organizer-serverless-todos-dev
USERS_TABLE=minocha-organizer-serverless-users-dev

# Application Configuration
NODE_ENV=development
API_VERSION=v1

# Optional: Custom Domain Configuration
# CUSTOM_DOMAIN=api.yourfamilyorganizer.com
# CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/your-cert-id

# Optional: CloudWatch Logs Configuration
LOG_LEVEL=info
LOG_RETENTION_DAYS=14

# Optional: S3 Bucket Configuration
# WEBSITE_BUCKET_NAME=your-custom-bucket-name

# Development Only - Remove in production
DEBUG=true

# Default Password for Demo Users (Express/Local Development)
# IMPORTANT: Used for hardcoded demo family members in src/config/auth.js
# Change this to a secure password or remove demo users in production
DEFAULT_PASSWORD=Family2024!Secure

# Rate Limiting Configuration
# General API rate limiter (applies to all API routes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Authentication endpoint rate limiter (login, refresh, validate)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# Strict rate limiter (password reset, account changes)
STRICT_RATE_LIMIT_WINDOW_MS=3600000
STRICT_RATE_LIMIT_MAX_REQUESTS=3

# Family code lookup rate limiter
FAMILY_CODE_RATE_LIMIT_WINDOW_MS=3600000
FAMILY_CODE_RATE_LIMIT_MAX_REQUESTS=10

# Account creation rate limiter
CREATE_ACCOUNT_RATE_LIMIT_WINDOW_MS=3600000
CREATE_ACCOUNT_RATE_LIMIT_MAX_REQUESTS=3

# Family Code Configuration
# Length of family invite codes (8-12 recommended, default: 10)
FAMILY_CODE_LENGTH=10

# CORS Configuration
# Comma-separated list of allowed origins for CORS (production only)
# Example: https://yourdomain.com,https://www.yourdomain.com,https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001